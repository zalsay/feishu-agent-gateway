# Create one Feishu enterprise app with its bot enabled, receive-message event and send-message scope.
FEISHU_APP_ID=cli_your_app_id
FEISHU_APP_SECRET=replace_me
# Sender IDs from the normalized Feishu message (usually open_id); no wildcard is supported.
FEISHU_ALLOWED_USER_IDS=ou_your_open_id

# Hermes API server: API_SERVER_ENABLED=true and API_SERVER_KEY=<same key> on Hermes.
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=replace_me
HERMES_MODEL=hermes-agent

# Absolute path to a trusted Git checkout accessible to Codex.
CODEX_REPO=/absolute/path/to/your/repository
CODEX_BIN=codex
# Create this dedicated directory and authenticate Codex within it before startup.
GATEWAY_CODEX_HOME=/absolute/path/to/private/codex-home
GATEWAY_STATE_PATH=./state.json

# Optional: only set to 1 when explicitly running paid, real-provider smoke tests.
# GATEWAY_LIVE_TEST=1

# Optional named Agent instances. Empty/unset preserves the legacy two-Agent configuration.
# Copy agents.example.json and point to it; JSON stores env names, not credential values.
# AGENT_CONFIG_PATH=/absolute/path/to/agents.json
